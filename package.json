{
  "name": "@profpowell/code-playground",
  "version": "0.2.0",
  "description": "A standalone web component for live HTML, CSS, and JavaScript editing with sandboxed preview and console output",
  "type": "module",
  "main": "dist/code-playground.js",
  "module": "dist/code-playground.js",
  "types": "code-playground.d.ts",
  "exports": {
    ".": {
      "types": "./code-playground.d.ts",
      "import": "./dist/code-playground.js",
      "default": "./dist/code-playground.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "code-playground.d.ts",
    "custom-elements.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "lint": "eslint src/ test/",
    "lint:fix": "eslint src/ test/ --fix",
    "format": "prettier --write \"src/**/*.js\" \"test/**/*.js\"",
    "format:check": "prettier --check \"src/**/*.js\" \"test/**/*.js\"",
    "analyze": "cem analyze",
    "prepublishOnly": "npm run lint && npm run test && npm run build && npm run analyze"
  },
  "customElements": "custom-elements.json",
  "keywords": [
    "web-components",
    "custom-elements",
    "vanilla-js",
    "code-playground",
    "editor",
    "preview",
    "tutorial",
    "sandbox",
    "profpowell-web-components"
  ],
  "author": "Thomas A. Powell",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ProfPowell/code-playground.git"
  },
  "bugs": {
    "url": "https://github.com/ProfPowell/code-playground/issues"
  },
  "homepage": "https://profpowell.github.io/code-playground/",
  "dependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.4",
    "@codemirror/language": "^6.11.3",
    "@codemirror/state": "^6.5.2",
    "@lezer/highlight": "^1.2.1",
    "codemirror": "^6.0.1"
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.57.0",
    "@profpowell/code-block": "^2.9.0",
    "eslint": "^9.39.2",
    "prettier": "^3.8.0",
    "vanilla-breeze": "^0.5.0",
    "vite": "^7.3.1"
  }
}
